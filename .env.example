# ShopManager AI server configuration. Copy to .env and edit.
#
# This is the open-source Free build: it reads a Shopify store and never writes
# to it. There is no licensing, no account and no phone-home.

# --- Server ---
PORT=3000
APP_URL=http://localhost:3000            # public URL of this server; Shopify calls back to it
DATA_DIR=./data                          # SQLite database, blobs, dev master key
LOG_LEVEL=info

# --- Secrets ---
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, a development key is written to DATA_DIR/dev-master.key. Never do
# that in production: it is the key your stored Shopify credentials are
# encrypted with.
SHOPMANAGER_MASTER_KEY=

# --- Demo mode ---
# 1 serves a single fake store (demo.myshopify.com) and needs no Shopify
# credentials at all. Useful for trying the tools before connecting a store.
SHOPMANAGER_DEMO=0

# --- Shopify ---
# Create an app in the Shopify Dev Dashboard and paste its credentials here.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Least privilege: this list is generated from the scopes the 122 shipped tools
# actually declare, plus read_themes for the Admin-API theme engine. It contains
# no write scopes, and CI fails if a tool ever needs one.
SHOPIFY_SCOPES=read_checkout_branding_settings,read_content,read_discounts,read_files,read_inventory,read_locales,read_locations,read_markets,read_metaobject_definitions,read_metaobjects,read_online_store_navigation,read_pixels,read_products,read_publications,read_script_tags,read_themes,read_translations

# --- Theme Access ---
# Theme file reads go through Shopify's Theme Access proxy. See SECURITY.md for
# what that credential can do and how to revoke it.
THEME_ACCESS_PROXY_BASE=https://theme-kit-access.shopifyapps.com/cli/admin/api

# --- Database ---
# SQLite by default. Set a postgres:// URL to use Postgres instead.
# DATABASE_URL=

# --- MCP ---
MCP_RATE_LIMIT_PER_MIN=600               # requests per minute per credential
